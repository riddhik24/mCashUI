<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pinky"
    tools:context=".ui.inviteAFriend.inviteFriend">
    <ImageView
        android:layout_width="353dp"
        android:layout_height="296dp"
        android:layout_gravity="center"
        android:paddingTop="60dp"
        android:cropToPadding="true"
        android:src="@drawable/invite1"
        android:tintMode="add" />


    <TextView
        android:id="@+id/text_inviteFriend"
        android:layout_width="343dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:text="Your Referral Code"
        android:textAlignment="center"
        android:textColor="@color/purple"
        android:textSize="25sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/dotted_lines" />

    <TextView
        android:layout_width="358dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:text="https://play.google.com/store/apps/details?id=in.mcash.app.referrer=4385525"
        android:textAlignment="center"
        android:clickable="true"
        android:textColor="@color/black"
        android:textSize="16dp"/>


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/dotted_lines" />

    <TextView
        android:layout_width="383dp"
        android:layout_height="69dp"
        android:text="Invite your friends by using the referral code above and earn 200 coins for every sign up using your code."
        android:textAlignment="center"
        android:layout_gravity="center"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"
        android:textSize="16dp"/>

    <Button
        android:layout_width="240dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:text="Invite"
        android:textSize="25dp"
        android:textStyle="bold"/>

</LinearLayout>